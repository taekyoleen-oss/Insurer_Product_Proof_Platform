# IPPP 하네스 — 격리 DB 자격 (이 파일을 .env.harness 로 복사하여 사용)
# 반드시 로컬(`supabase start`) 또는 별도 "테스트" 프로젝트를 가리켜야 합니다.
# 운영(.env.local) URL 과 동일하면 하네스가 자동으로 중단됩니다.

# 로컬 Supabase 예시 (supabase start 출력값 사용):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<로컬 anon key>
SUPABASE_SERVICE_ROLE_KEY=<로컬 service_role key>

# 운영 URL 을 의도적으로 사용해야 하는 경우에만(권장하지 않음):
# HARNESS_ALLOW_PROD=I_UNDERSTAND
